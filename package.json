  {
  "name": "portal-mfe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "publicar": "node scripts/publicar.mjs",
    "revertir": "node scripts/revertir.mjs",
    "servir:shell": "http-server hosting/shell -p 8080 -c-1 -P http://localhost:8080?",
    "servir:polizas": "http-server hosting/polizas -p 8081 -c-1 --cors",
    "servir:siniestros": "http-server hosting/siniestros -p 8082 -c-1 --cors",
    "dev": "concurrently -n polizas,siniestros,cotizador,cot-srv,shell -c green,red,yellow,yellow,magenta \"ng serve mfe-polizas\" \"ng serve mfe-siniestros\" \"npm --prefix projects/mfe-cotizador run build -- --watch\" \"http-server projects/mfe-cotizador/dist -p 4203 -c-1 --cors\" \"ng serve shell\"",
    "servir:cotizador": "http-server hosting/cotizador -p 8083 -c-1 --cors",
    "demo": "concurrently -n shell,polizas,siniestros,cotizador -c magenta,green,red,yellow \"npm:servir:shell\" \"npm:servir:polizas\" \"npm:servir:siniestros\" \"npm:servir:cotizador\"",
    "demo:base": "concurrently -n shell,polizas,cotizador -c magenta,green,yellow \"npm:servir:shell\" \"npm:servir:polizas\" \"npm:servir:cotizador\"",
    "e2e": "playwright test",
    "e2e:reporte": "playwright show-report",
    "publicar:azure": "node scripts/publicar-azure.mjs",
    "revertir:azure": "node scripts/revertir-azure.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@auth0/auth0-angular": "^2.13.0",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "~22.2.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@softarc/native-federation-orchestrator": "^4.8.0",
    "concurrently": "^10.0.6",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "browser-tabs-lock@1.3.0": true
  }
}
